#!/usr/bin/bash

# Test double for the one hyprctl surface Keycade LazyVim still uses: the read-only
# launch-preflight query behind bin/keybinds-json --guard-status. CI installs
# this root-owned as /usr/bin/hyprctl (.github/workflows/ci.yml) so the R7
# trusted-command checks have a binary to accept.
#
# It answers with the reply shape Hyprland 0.55+ emits for a boolean option,
# and only when the compositor socket the real hyprctl would connect through
# exists. Every other request - a different option, a retired binds/devices/
# batch interface, or a run with no compositor behind it - is refused, so a
# test drifting onto a dead interface fails instead of being silently
# answered.

set -euo pipefail

socket="${XDG_RUNTIME_DIR:-}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/.socket.sock"
if [[ $# -eq 3 && ${1:-} == "-j" && ${2:-} == "getoption" \
      && ${3:-} == "binds:disable_keybind_grabbing" \
      && -n ${HYPRLAND_INSTANCE_SIGNATURE:-} && -S ${socket} ]]; then
  printf '{"option": "binds:disable_keybind_grabbing", "bool": false, "set": false}\n'
else
  printf 'hyprctl mock: unsupported or unreachable request: %s\n' "$*" >&2
  exit 1
fi
