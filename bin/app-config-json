#!/usr/bin/python3
"""Emit what the training ground's own configuration says about itself.

The table Keycade deals for LazyVim is the upstream defaults, shipped with
the plugin. This helper reads the small, fixed-shape part of a machine's
configuration that says how those defaults were *changed*: which key every
other binding hangs off, which opt-in bundles are turned on, which upstream
version is installed, and which top-level literal keymap calls add, replace
or delete a binding. The same launch also reads Keycade's declarative decks.json
without writing it, keeping absence distinct from a malformed configuration.

What it will not do, in the words of the rule it lives under:

  Do not execute, load or interpret any of the user's configuration. Read only
  fixed shapes at fixed paths (declarative JSON, and top-level literal
  assignments and calls), bound every file, skip and count anything unreadable,
  and fall back to the shipped defaults when the whole read fails.

So: no Lua is run, no editor is started, no socket is opened, nothing is
fetched, no `require` chain is followed, no directory is walked and no symlink
is followed. Every path below is written out in full; the list is the contract.
An unreadable value is reported as skipped rather than guessed at, because a
guessed prefix teaches every card the wrong first key while a skipped one only
costs the reader a menu.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import stat
import sys
import unicodedata
from pathlib import Path
from typing import Any

SCHEMA_VERSION = 1
MAX_FILE_BYTES = 64 * 1024
MAX_PAYLOAD_BYTES = 256 * 1024
MAX_EXTRAS = 128
MAX_EXTRA_CHARS = 128
MAX_OPTION_CHARS = 32
MAX_COMMIT_CHARS = 64
MAX_BINDINGS = 128
MAX_LHS_CHARS = 128
MAX_DESC_CHARS = 512
MAX_LINE_CHARS = 4096
MAX_DECKS = 32
MAX_DECK_NAME_CHARS = 48
MAX_DECK_REJECTED = 100000
DECK_ID = re.compile(r"^[a-z][a-z0-9-]{0,31}$")
FORBIDDEN_KEYS = {"__proto__", "constructor", "prototype"}
SEED_LIMITS = {"categories": (24, 32), "extras": (32, 128), "contexts": (8, 32)}
# The checked-in JSON is the source of the compiled Packs.js, not user config.
PACK_ROOT = Path(__file__).absolute().parent.parent
TRAINED_MODES = {"n": "normal", "x": "visual", "v": "visual",
                 "o": "operator", "i": "insert"}

# Neovim resolves mapleader by taking its text and substituting it into the
# left-hand side, so "<Space>" is as valid a spelling as " ". `:help mapleader`
NOTATION = {"<space>": " ", "<bslash>": "\\", "<tab>": "\t", "<cr>": "\r"}

# A line that is about the option but not in a shape this may read. Telling
# "you never set it" from "you set it somewhere I cannot follow" is the whole
# difference between "the upstream default applies" and "please check this":
# the first needs no attention, the second does.
LEADER_MENTION = re.compile(
    r'\b(?:vim\.g(?:\.(?:mapleader|maplocalleader)|\s*\[)|'
    r'vim\.api\.nvim_set_var|vim\.cmd)'
)


def is_comment(line: str) -> bool:
    stripped = line.lstrip()
    return stripped.startswith("--") or stripped.startswith("#")

# The whole user-input contract, written out. The only additional read is the
# fixed shipped pack asset in deck_vocabulary(), never another user input.
FILES: dict[str, dict[str, list[str]]] = {
    "lazyvim": {
        # LazyVim's starter says options are loaded before lazy.nvim starts and
        # tells you to add yours here; the other two are where a minimal config
        # puts them instead.
        "leader": [
            ".config/nvim/lua/config/options.lua",
            ".config/nvim/lua/config/lazy.lua",
            ".config/nvim/init.lua",
        ],
        "extras": [".config/nvim/lazyvim.json"],
        "lock": [".config/nvim/lazy-lock.json"],
        "keymaps": [".config/nvim/lua/config/keymaps.lua"],
    },
    "keycade": {"decks": [".config/omarchy/keycade/decks.json"]},
}


class Skipped(Exception):
    """The value is there but not in a shape this may read."""


def has_controls(text: str) -> bool:
    return any(unicodedata.category(char).startswith("C") for char in text)


def sanitize_text(value: object, limit: int) -> str:
    text = unicodedata.normalize("NFC", str(value or ""))
    cleaned = "".join(" " if unicodedata.category(char).startswith("C") else char for char in text)
    return cleaned[:limit]


def read_text(home: Path, relative: str, *, strict: bool = False,
              max_bytes: int = MAX_FILE_BYTES) -> str | None:
    """One regular file by descriptor-relative path, bounded, no symlinks.

    Strict reads distinguish absence from unreadable/non-regular input. Walk
    the absolute anchor too: an XDG_CONFIG_HOME ancestor can itself be a link.
    Legacy calibration readers retain their missing/unreadable convention.
    """
    parts = Path(relative).parts
    anchor = home.parts
    if not parts or Path(relative).is_absolute() or not home.is_absolute() \
            or any(part in ("", ".", "..") for part in parts + anchor[1:]):
        if strict:
            raise Skipped("unsafe-path")
        return None
    directory = -1
    try:
        # O_NOFOLLOW on only the final file is insufficient: ~/.config/nvim
        # itself may be a link and would widen the fixed-path contract.
        directory = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        for part in anchor[1:] + parts[:-1]:
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                            dir_fd=directory)
            os.close(directory)
            directory = child
        descriptor = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                             dir_fd=directory)
    except OSError as error:
        if directory >= 0:
            os.close(directory)
        if strict and not isinstance(error, FileNotFoundError):
            raise Skipped("unreadable") from None
        return None
    os.close(directory)
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            if strict:
                raise Skipped("non-regular")
            return None
        with os.fdopen(descriptor, "rb", closefd=False) as handle:
            raw = handle.read(max_bytes + 1)
    except OSError:
        if strict:
            raise Skipped("unreadable") from None
        return None
    finally:
        os.close(descriptor)
    if len(raw) > max_bytes:
        raise Skipped("too-large" if strict else f"{relative} exceeds {max_bytes} bytes")
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        raise Skipped("invalid-utf8" if strict else f"{relative} is not UTF-8") from None


def long_bracket(text: str, start: int) -> tuple[str, int] | None:
    """Return a Lua long string/comment body and its exclusive end."""
    match = re.match(r"\[(=*)\[", text[start:])
    if not match:
        return None
    marker = "]" + match.group(1) + "]"
    body_start = start + match.end()
    end = text.find(marker, body_start)
    if end < 0:
        return None
    body = text[body_start:end]
    # Lua discards the first newline immediately after a long-string opener.
    if body.startswith("\r\n"):
        body = body[2:]
    elif body.startswith("\n"):
        body = body[1:]
    return body, end + len(marker)


def decode_lua_short(text: str) -> str | None:
    """Decode one complete Lua single/double quoted literal, without eval."""
    if len(text) < 2 or text[0] not in "\"'" or text[-1] != text[0]:
        return None
    result: list[str] = []
    index = 1
    end = len(text) - 1
    simple = {"a": "\a", "b": "\b", "f": "\f", "n": "\n", "r": "\r",
              "t": "\t", "v": "\v", "\\": "\\", '"': '"', "'": "'"}
    while index < end:
        char = text[index]
        if char != "\\":
            if char in "\r\n":
                return None
            result.append(char)
            index += 1
            continue
        index += 1
        if index >= end:
            return None
        escaped = text[index]
        if escaped in simple:
            result.append(simple[escaped])
            index += 1
        elif escaped == "z":
            index += 1
            while index < end and text[index].isspace():
                index += 1
        elif escaped == "x" and index + 2 < end \
                and re.fullmatch(r"[0-9A-Fa-f]{2}", text[index + 1:index + 3]):
            result.append(chr(int(text[index + 1:index + 3], 16)))
            index += 3
        elif escaped == "u" and index + 1 < end and text[index + 1] == "{":
            close = text.find("}", index + 2, end)
            digits = text[index + 2:close] if close >= 0 else ""
            if not digits or not re.fullmatch(r"[0-9A-Fa-f]{1,8}", digits):
                return None
            try:
                result.append(chr(int(digits, 16)))
            except ValueError:
                return None
            index = close + 1
        elif escaped.isdigit():
            match = re.match(r"\d{1,3}", text[index:end])
            assert match is not None
            number = int(match.group(0), 10)
            if number > 255:
                return None
            result.append(chr(number))
            index += len(match.group(0))
        elif escaped == "\n":
            result.append("\n")
            index += 1
        elif escaped == "\r" and index + 1 < end and text[index + 1] == "\n":
            result.append("\n")
            index += 2
        else:
            return None
    return "".join(result)


def lua_string(value: str) -> str | None:
    """One complete short or long Lua string, without evaluating Lua."""
    text = value.strip()
    if not text:
        return None
    if text[0] in "\"'":
        return decode_lua_short(text)
    found = long_bracket(text, 0)
    return found[0] if found and found[1] == len(text) else None


def without_lua_comments(text: str) -> str | None:
    """Blank comments while preserving strings, offsets and newlines."""
    output = list(text)
    index = 0
    while index < len(text):
        char = text[index]
        if char in "\"'":
            quote = char
            index += 1
            while index < len(text):
                if text[index] == "\\":
                    index += 2
                elif text[index] == quote:
                    index += 1
                    break
                else:
                    index += 1
            else:
                return None
            continue
        long_open = re.match(r"\[(=*)\[", text[index:]) if char == "[" else None
        opened = long_bracket(text, index) if long_open else None
        if long_open and not opened:
            return None
        if opened:
            index = opened[1]
            continue
        if text.startswith("--", index):
            block_open = re.match(r"\[(=*)\[", text[index + 2:])
            block = long_bracket(text, index + 2) if block_open else None
            if block_open and not block:
                return None
            end = block[1] if block else text.find("\n", index)
            if end < 0:
                end = len(text)
            for position in range(index, end):
                if output[position] not in "\r\n":
                    output[position] = " "
            index = end
            continue
        index += 1
    return "".join(output)


def long_string_spans(text: str) -> list[tuple[int, int]]:
    """Where the bodies of Lua long strings are, as [start, end) offsets.

    Comments are blanked before anything is read, but long *strings* are not:
    `vim.cmd [[let mapleader = " "]]` needs its contents to be readable. That
    left the other direction open - a `[[ ... ]]` block quoting configuration
    as documentation had its lines read as configuration, so a leader named
    inside a string became the leader the whole deck was built on.

    A statement that begins outside a long string is still read in full; only
    lines that start inside one are passed over.
    """
    spans: list[tuple[int, int]] = []
    index = 0
    while index < len(text):
        char = text[index]
        if char in "\"'":
            quote = char
            index += 1
            while index < len(text):
                if text[index] == "\\":
                    index += 2
                elif text[index] == quote:
                    index += 1
                    break
                else:
                    index += 1
            continue
        if char == "[" and re.match(r"\[(=*)\[", text[index:]):
            opened = long_bracket(text, index)
            if not opened:
                break
            spans.append((index, opened[1]))
            index = opened[1]
            continue
        index += 1
    return spans


def line_offsets(text: str) -> list[int]:
    """The absolute offset each line of splitlines() starts at."""
    offsets: list[int] = []
    position = 0
    for line in text.splitlines():
        offsets.append(position)
        position += len(line) + 1
    return offsets


def within(spans: list[tuple[int, int]], position: int) -> bool:
    return any(start < position < end for start, end in spans)


def split_lua_args(body: str, separators: str = ",") -> list[str] | None:
    """Split Lua fields while respecting strings, comments and delimiters."""
    clean = without_lua_comments(body)
    if clean is None:
        return None
    args: list[str] = []
    start = 0
    stack: list[str] = []
    pairs = {')': '(', ']': '[', '}': '{'}
    index = 0
    while index < len(clean):
        char = clean[index]
        if char in "\"'":
            quote = char
            index += 1
            while index < len(clean):
                if clean[index] == "\\":
                    index += 2
                elif clean[index] == quote:
                    index += 1
                    break
                else:
                    index += 1
            else:
                return None
            continue
        opened = long_bracket(clean, index) if char == "[" else None
        if opened:
            index = opened[1]
            continue
        if char in "([{":
            stack.append(char)
        elif char in ")]}":
            if not stack or stack.pop() != pairs[char]:
                return None
        elif char in separators and not stack:
            args.append(clean[start:index].strip())
            start = index + 1
        index += 1
    if stack:
        return None
    args.append(clean[start:].strip())
    return args


def call_parts(statement: str) -> tuple[str, list[str]] | None:
    """An exact dotted-name parenthesized call and its top-level arguments."""
    clean = without_lua_comments(statement)
    if clean is None:
        return None
    match = re.match(r"^([A-Za-z_]\w*(?:\.[A-Za-z_]\w*)*)\s*\(", clean)
    if not match:
        return None
    open_at = clean.find("(", match.start())
    stack: list[str] = []
    pairs = {')': '(', ']': '[', '}': '{'}
    index = open_at
    close_at = -1
    while index < len(clean):
        char = clean[index]
        if char in "\"'":
            quote = char
            index += 1
            while index < len(clean):
                if clean[index] == "\\":
                    index += 2
                elif clean[index] == quote:
                    index += 1
                    break
                else:
                    index += 1
            else:
                return None
            continue
        opened = long_bracket(clean, index) if char == "[" else None
        if opened:
            index = opened[1]
            continue
        if char in "([{":
            stack.append(char)
        elif char in ")]}":
            if not stack or stack.pop() != pairs[char]:
                return None
            if not stack:
                close_at = index
                break
        index += 1
    if close_at < 0 or clean[close_at + 1:].strip() not in ("", ";"):
        return None
    args = split_lua_args(clean[open_at + 1:close_at])
    if args and not args[-1]:
        args.pop()
    return (match.group(1), args) if args is not None else None


def delimiters_balanced(text: str) -> bool:
    clean = without_lua_comments(text)
    if clean is None:
        return False
    stack: list[str] = []
    pairs = {')': '(', ']': '[', '}': '{'}
    index = 0
    while index < len(clean):
        char = clean[index]
        if char in "\"'":
            quote = char
            index += 1
            while index < len(clean):
                if clean[index] == "\\":
                    index += 2
                elif clean[index] == quote:
                    index += 1
                    break
                else:
                    index += 1
            continue
        opened = long_bracket(clean, index) if char == "[" else None
        if opened:
            index = opened[1]
            continue
        if char in "([{":
            stack.append(char)
        elif char in ")]}":
            if not stack or stack.pop() != pairs[char]:
                return False
        index += 1
    return not stack


def complete_statement(lines: list[str], start: int) -> tuple[str, int]:
    """Collect a bounded statement, allowing Stylua's multiline calls."""
    statement = lines[start]
    end = start
    while end + 1 < len(lines) and len(statement) <= MAX_LINE_CHARS:
        if delimiters_balanced(statement):
            break
        end += 1
        statement += "\n" + lines[end]
    return statement, end


def literal_modes(value: str) -> list[str] | None:
    text = value.strip()
    single = lua_string(text)
    names: list[str]
    if single is not None:
        names = [single]
    elif text.startswith("{") and text.endswith("}"):
        parts = split_lua_args(text[1:-1])
        if parts is None:
            return None
        names = []
        for index, part in enumerate(parts):
            if not part and index == len(parts) - 1:
                continue
            name = lua_string(part)
            if name is None:
                return None
            names.append(name)
    else:
        return None
    contexts: list[str] = []
    for name in names:
        context = TRAINED_MODES.get(name)
        if context and context not in contexts:
            contexts.append(context)
    return contexts or None


def literal_options(options: str) -> tuple[str | None, bool] | None:
    """Description and buffer-local flag from one literal options table."""
    text = options.strip()
    if not text.startswith("{") or not text.endswith("}"):
        return None
    fields = split_lua_args(text[1:-1], ",;")
    if fields is None:
        return None
    description: str | None = None
    buffer_local = False
    for field in fields:
        if not field:
            continue
        match = re.match(r"^([A-Za-z_]\w*)\s*=\s*(.*)$", field, re.DOTALL)
        name = match.group(1) if match else ""
        value = match.group(2) if match else ""
        if not match:
            bracket = re.match(
                r"^\[\s*((?:\"(?:[^\"\\]|\\.)*\")|(?:'(?:[^'\\]|\\.)*'))\s*\]\s*=\s*(.*)$",
                field, re.DOTALL)
            if bracket:
                name = lua_string(bracket.group(1)) or ""
                value = bracket.group(2)
        if name in ("buffer", "buf"):
            buffer_local = True
        elif name == "desc":
            found = lua_string(value)
            if found is None or (description is not None and found != description):
                return None
            description = found
    if description is not None:
        if not description or len(description) > MAX_DESC_CHARS:
            description = None
        else:
            description = sanitize_text(description, MAX_DESC_CHARS)
            if not description.strip():
                description = None
    return description, buffer_local


KEYMAP_APIS = {
    "vim.keymap.set": "set",
    "vim.keymap.del": "del",
    "vim.api.nvim_set_keymap": "set",
    "vim.api.nvim_del_keymap": "del",
    "LazyVim.safe_keymap_set": "set",
}
KEYMAP_MENTION = re.compile(
    r"\b(?:vim\.keymap\.(?:set|del)|vim\.api\.nvim_(?:set|del)_keymap|"
    r"LazyVim\.safe_keymap_set)\b"
)
ALIAS = re.compile(
    r"^local\s+([A-Za-z_]\w*)\s*=\s*"
    r"(vim\.keymap\.(?:set|del)|vim\.api\.nvim_(?:set|del)_keymap|"
    r"LazyVim\.safe_keymap_set)\s*;?\s*$"
)


def read_keymaps(home: Path, files: list[str]) -> tuple[list[dict[str, Any]], dict[str, int]]:
    """Top-level literal set/del calls, including balanced multiline forms."""
    bindings: list[dict[str, Any]] = []
    skipped: dict[str, int] = {}

    def drop(reason: str) -> None:
        skipped[reason] = skipped.get(reason, 0) + 1

    for relative in files:
        text = read_text(home, relative)
        if text is None:
            continue
        clean_text = without_lua_comments(text)
        if clean_text is None:
            drop("unsupported-shape")
            continue
        aliases: dict[str, str] = {}
        invalid_aliases: set[str] = set()
        lines = clean_text.splitlines()
        quoted = long_string_spans(clean_text)
        offsets = line_offsets(clean_text)
        line_index = 0
        while line_index < len(lines):
            line = lines[line_index]
            stripped = line.lstrip()
            # Text quoted in a [[ ]] block is a string, whatever it looks like.
            if within(quoted, offsets[line_index]):
                line_index += 1
                continue
            if is_comment(line):
                line_index += 1
                continue
            if len(line) > MAX_LINE_CHARS:
                drop("line-too-long")
                line_index += 1
                continue
            clean_line = without_lua_comments(line)
            clean_line = clean_line.strip() if clean_line is not None else ""
            alias = ALIAS.fullmatch(clean_line) if not line[:1].isspace() else None
            if alias:
                name, target = alias.groups()
                if name not in invalid_aliases:
                    aliases[name] = target
                line_index += 1
                continue
            # Only at column zero. `function helper(map) map = wrap(map) end`
            # rebinds a parameter of that name, not the file's own alias, and
            # retiring the alias there cost every call after it.
            reassigned = (re.match(r"^(?:local\s+)?([A-Za-z_]\w*)\s*=", clean_line)
                          if not line[:1].isspace() else None)
            if reassigned and reassigned.group(1) in aliases:
                invalid_aliases.add(reassigned.group(1))
                aliases.pop(reassigned.group(1), None)
                drop("alias-reassigned")
                line_index += 1
                continue
            called = re.match(r"^([A-Za-z_]\w*(?:\.[A-Za-z_]\w*)*)\s*\(", stripped)
            name = called.group(1) if called else ""
            known = name in KEYMAP_APIS or name in aliases
            if line[:1].isspace() and (KEYMAP_MENTION.match(stripped) or name in aliases):
                drop("indented")
                line_index += 1
                continue
            if not known:
                if KEYMAP_MENTION.match(stripped):
                    drop("unsupported-shape")
                line_index += 1
                continue
            statement, statement_end = complete_statement(lines, line_index)
            line_index = statement_end + 1
            if len(statement) > MAX_LINE_CHARS:
                drop("line-too-long")
                continue
            parsed = call_parts(statement)
            if parsed is None:
                drop("unsupported-shape")
                continue
            function, args = parsed
            target = aliases.get(function, function)
            op = KEYMAP_APIS.get(target)
            if op is None or len(args) not in ((4,) if op == "set" else (2, 3)):
                drop("unsupported-shape")
                continue
            modes = literal_modes(args[0])
            lhs = lua_string(args[1])
            if not modes:
                drop("untrained-mode")
                continue
            if not lhs or len(lhs) > MAX_LHS_CHARS or has_controls(lhs):
                drop("non-literal-lhs")
                continue
            record: dict[str, Any] = {"op": op, "contexts": modes, "lhs": lhs}
            if op == "set":
                options = literal_options(args[3])
                if options is None:
                    drop("dynamic-options")
                    continue
                desc, buffer_local = options
                if buffer_local:
                    drop("buffer-local")
                    continue
                if not desc:
                    drop("missing-description")
                    continue
                record["desc"] = desc
            elif len(args) == 3:
                options = literal_options(args[2])
                if options is None:
                    drop("dynamic-options")
                    continue
                if options[1]:
                    drop("buffer-local")
                    continue
            if len(bindings) >= MAX_BINDINGS:
                drop("too-many-bindings")
                continue
            bindings.append(record)
    return bindings, skipped


def option_value(value: str) -> str:
    value = NOTATION.get(value.lower(), value)
    if not value or len(value) > MAX_OPTION_CHARS or has_controls(value):
        raise Skipped("value is not a key")
    return value


def leader_expression(value: str) -> str | None:
    """A literal key, optionally passed through the exact vim.keycode API."""
    direct = lua_string(value)
    if direct is not None:
        try:
            return option_value(direct)
        except Skipped:
            return None
    called = call_parts(value)
    if called and called[0] == "vim.keycode" and len(called[1]) == 1:
        literal = lua_string(called[1][0])
    else:
        match = re.match(r"^vim\.keycode\s+(.+)$", value.strip(), re.DOTALL)
        literal = lua_string(match.group(1)) if match else None
    if literal is None:
        return None
    try:
        return option_value(NOTATION.get(literal.lower(), literal))
    except Skipped:
        return None


def vim_cmd_leader(command: str) -> tuple[str, str] | None:
    """The one allowed Vimscript statement inside vim.cmd."""
    match = re.fullmatch(
        r"\s*let\s+(?:g:)?(mapleader|maplocalleader)\s*=\s*"
        r"(\"(?:[^\"\\]|\\.)*\"|'(?:[^'\\]|\\.)*')\s*",
        command, re.DOTALL)
    if not match:
        return None
    value = lua_string(match.group(2))
    if value is None:
        return None
    try:
        return match.group(1), option_value(value)
    except Skipped:
        return None


def parse_leader_statement(statement: str) -> tuple[str, str] | None:
    clean = without_lua_comments(statement)
    if clean is None:
        return None
    clean = clean.strip()
    if clean.endswith(";"):
        clean = clean[:-1].rstrip()

    assignment = re.fullmatch(
        r"vim\.g(?:\.(mapleader|maplocalleader)|\[\s*"
        r"((?:\"(?:[^\"\\]|\\.)*\")|(?:'(?:[^'\\]|\\.)*'))\s*\])"
        r"\s*=\s*(.+)", clean, re.DOTALL)
    if assignment:
        name = assignment.group(1) or lua_string(assignment.group(2))
        value = leader_expression(assignment.group(3))
        if name in ("mapleader", "maplocalleader") and value is not None:
            return name, value
        return None

    called = call_parts(clean)
    if called and called[0] == "vim.api.nvim_set_var" and len(called[1]) == 2:
        name = lua_string(called[1][0])
        value = leader_expression(called[1][1])
        if name in ("mapleader", "maplocalleader") and value is not None:
            return name, value
        return None
    if called and called[0] == "vim.cmd" and len(called[1]) == 1:
        command = lua_string(called[1][0])
        return vim_cmd_leader(command) if command is not None else None
    command_call = re.fullmatch(r"vim\.cmd\s+(.+)", clean, re.DOTALL)
    if command_call:
        command = lua_string(command_call.group(1))
        return vim_cmd_leader(command) if command is not None else None
    return None


def read_leader(home: Path, files: list[str]) -> tuple[dict[str, str], dict[str, str]]:
    """Statically decidable top-level leader assignments and exact APIs."""
    found: dict[str, set[str]] = {}
    mentioned: set[str] = set()
    for relative in files:
        text = read_text(home, relative)
        if text is None:
            continue
        clean_text = without_lua_comments(text)
        if clean_text is None:
            for name in ("mapleader", "maplocalleader"):
                if name in text:
                    mentioned.add(name)
            continue
        lines = clean_text.splitlines()
        quoted = long_string_spans(clean_text)
        offsets = line_offsets(clean_text)
        index = 0
        while index < len(lines):
            line = lines[index]
            if within(quoted, offsets[index]):
                index += 1
                continue
            if is_comment(line):
                index += 1
                continue
            if not LEADER_MENTION.search(line):
                index += 1
                continue
            for name in ("mapleader", "maplocalleader"):
                if name in line:
                    mentioned.add(name)
            if line[:1].isspace():
                index += 1
                continue
            statement, end = complete_statement(lines, index)
            index = end + 1
            for name in ("mapleader", "maplocalleader"):
                if name in statement:
                    mentioned.add(name)
            parsed = parse_leader_statement(statement)
            if parsed:
                found.setdefault(parsed[0], set()).add(parsed[1])

    options: dict[str, str] = {}
    skipped: dict[str, str] = {}
    for name, option in (("mapleader", "leader"), ("maplocalleader", "localleader")):
        values = found.get(name)
        if values and len(values) == 1:
            options[option] = next(iter(values))
        elif values:
            # Which one wins depends on load order, which is a question about
            # running the configuration rather than reading it.
            skipped[option] = "assigned more than one value"
        elif name in mentioned:
            skipped[option] = "assigned in a shape this cannot read"
        else:
            skipped[option] = "never assigned"
    return options, skipped


def read_json(home: Path, relative: str, *, strict: bool = False,
              missing: Any = None, max_bytes: int = MAX_FILE_BYTES) -> Any:
    text = read_text(home, relative, strict=strict, max_bytes=max_bytes)
    if text is None:
        return missing
    try:
        # Python otherwise accepts NaN/Infinity, which JSON.parse does not.
        def reject_constant(value: str) -> None:
            raise ValueError(value)
        return json.loads(text, parse_constant=reject_constant)
    except (ValueError, RecursionError):
        raise Skipped("invalid-json" if strict else f"{relative} is not valid JSON") from None


def deck_name(value: str) -> str:
    """Strip terminal sequences, C0/C1, bidi and lone surrogates, then cap.

    Same scanner as DeckValidation.safeName: ESC has zero or more 0x20..0x2f
    intermediates and a 0x30..0x7e final (including ESC7, ESC=, ESCc, ESC#8).
    CSI consumes parameters/intermediates through its 0x40..0x7e final. String
    controls consume through ST (OSC also BEL). CAN/SUB cancel a sequence;
    another ESC restarts a non-string sequence. Malformed bytes are discarded
    within a sequence, and truncated sequences/strings discard to end-of-input
    rather than exposing their command bytes. Nothing executes terminal code.
    """
    text = []
    state = "text"
    intermediate = False
    string_bel = False
    string_escape = False
    for char in value:
        code = ord(char)
        if state != "text":
            if code in (0x18, 0x1a):
                state = "text"
                continue
            if state == "string":
                if code == 0x9c or (string_escape and char == "\\") \
                        or (string_bel and code == 0x07):
                    state = "text"
                string_escape = code == 0x1b
                continue
            if code == 0x1b:
                state, intermediate = "escape", False
                continue
            if code == 0x9b:
                state = "csi"
                continue
            if code in (0x90, 0x98, 0x9d, 0x9e, 0x9f):
                state, string_bel, string_escape = "string", code == 0x9d, False
                continue
            if code <= 0x1f or code == 0x7f:
                continue
            if state == "csi":
                if 0x40 <= code <= 0x7e:
                    state = "text"
            elif not intermediate and char == "[":
                state = "csi"
            elif not intermediate and char in "]PX^_":
                state, string_bel, string_escape = "string", char == "]", False
            elif 0x20 <= code <= 0x2f:
                intermediate = True
            elif 0x30 <= code <= 0x7e:
                state = "text"
            continue
        if code == 0x1b:
            state, intermediate = "escape", False
        elif code == 0x9b:
            state = "csi"
        elif code in (0x90, 0x98, 0x9d, 0x9e, 0x9f):
            state, string_bel, string_escape = "string", code == 0x9d, False
        else:
            text.append(char)
    value = "".join(text)
    value = re.sub(r"[\x00-\x1f\x7f-\x9f\u061c\u200e\u200f\u2028-\u202e\u2066-\u206f\ud800-\udfff]", "", value)
    return value[:MAX_DECK_NAME_CHARS]


def deck_result(status: str, reason: str = "", *, decks: list | None = None,
                rejected: int = 0) -> dict[str, Any]:
    """Transport contract, also independently rebuilt by DeckValidation.js.

    absent -> starters later; invalid -> all only later; valid (even []) ->
    replace starters later. No implicit all/starter or membership is emitted.
    Seed omission, {} and explicit empty dimensions remain distinguishable.
    'all' retains only its name. Reasons are fixed tokens, never user text.
    Rejections count unknown keys, invalid/duplicate items and capped entries.
    """
    return {"schemaVersion": 1, "status": status, "reason": reason,
            "decks": decks or [], "rejected": min(MAX_DECK_REJECTED, rejected)}


def deck_vocabulary() -> dict[str, set[str]]:
    """Use the real shipped pack, never a second copied vocabulary or Lua.

    Pack contexts are the build-time subset of Profiles.contexts('lazyvim');
    the consumer additionally checks the live static profile declaration.
    This larger budget applies ONLY to this fixed application asset.
    """
    pack = read_json(PACK_ROOT, "assets/packs/lazyvim.json", strict=True,
                     max_bytes=MAX_PAYLOAD_BYTES)
    if not isinstance(pack, dict) or pack.get("profile") != "lazyvim" \
            or pack.get("schemaVersion") != 1:
        raise Skipped("vocabulary-unavailable")
    result: dict[str, set[str]] = {}
    for key, (_, chars) in SEED_LIMITS.items():
        values = pack.get(key)
        if not isinstance(values, list) or len(values) > MAX_EXTRAS \
                or any(not isinstance(value, str) or not 0 < len(value) <= chars
                       or value in FORBIDDEN_KEYS or has_controls(value) for value in values):
            raise Skipped("vocabulary-unavailable")
        result[key] = set(values)
    return result


def read_decks(home: Path, files: list[str]) -> dict[str, Any]:
    """Read-only D1/D2 boundary. Never execute config or confuse null/absence.

    XDG_CONFIG_HOME is absolute by specification. An invalid/non-readable XDG
    path is an invalid config, not permission to silently read another file.
    """
    absent = object()
    try:
        config_home = os.environ.get("XDG_CONFIG_HOME", "")
        if config_home:
            if not config_home.startswith("/") or len(config_home) > 4096 \
                    or has_controls(config_home) or ".." in Path(config_home).parts:
                return deck_result("invalid", "unsafe-config-home", rejected=1)
            anchor = Path(config_home)
            relative = "omarchy/keycade/decks.json"
        else:
            anchor, relative = home, files[0]
        value = read_json(anchor, relative, strict=True, missing=absent)
        if value is absent:
            return deck_result("absent")
        if not isinstance(value, dict) or type(value.get("schemaVersion")) is not int \
                or value["schemaVersion"] != 1 or not isinstance(value.get("decks"), list):
            return deck_result("invalid", "invalid-schema", rejected=1)
        vocabulary = deck_vocabulary()
    except Skipped as error:
        return deck_result("invalid", str(error), rejected=1)

    rejected = len(value.keys() - {"schemaVersion", "decks"})
    declarations = value["decks"]
    rejected += max(0, len(declarations) - MAX_DECKS)
    seen: set[str] = set()
    decks = []
    for item in declarations[:MAX_DECKS]:
        if not isinstance(item, dict):
            rejected += 1
            continue
        rejected += len(item.keys() - {"id", "name", "seed"})
        deck_id = item.get("id")
        if not isinstance(deck_id, str) or not DECK_ID.fullmatch(deck_id) \
                or deck_id in FORBIDDEN_KEYS or deck_id in seen:
            rejected += 1
            continue
        # Reserve the first declaration even if another field is malformed.
        seen.add(deck_id)
        name = deck_name(item["name"]) if isinstance(item.get("name"), str) else ""
        if not name.strip():
            rejected += 1
            continue
        deck = {"id": deck_id, "name": name}
        if "seed" in item and deck_id != "all":
            seed = item["seed"]
            if not isinstance(seed, dict):
                rejected += 1
                continue
            rejected += len(seed.keys() - SEED_LIMITS.keys())
            accepted_seed = {}
            for key, (count, chars) in SEED_LIMITS.items():
                if key not in seed:
                    continue
                values = seed[key]
                accepted = []
                if not isinstance(values, list):
                    rejected += 1
                else:
                    rejected += max(0, len(values) - count)
                    for name in values[:count]:
                        if not isinstance(name, str) or not 0 < len(name) <= chars \
                                or name in FORBIDDEN_KEYS or name not in vocabulary[key] \
                                or name in accepted:
                            rejected += 1
                        else:
                            accepted.append(name)
                # Preserve []: unknown values must not widen a seed by turning
                # a specified (but rejected) dimension into an omitted one.
                accepted_seed[key] = accepted
            deck["seed"] = accepted_seed
        decks.append(deck)
    result = deck_result("valid", decks=decks, rejected=rejected)
    if len(json.dumps(result, ensure_ascii=False, separators=(",", ":")).encode("utf-8")) > MAX_FILE_BYTES:
        return deck_result("invalid", "too-large", rejected=rejected + 1)
    return result


def read_extras(home: Path, files: list[str]) -> tuple[list[str], dict[str, str]]:
    """Which opt-in bundles are turned on. Declarative, so no shape to guess."""
    for relative in files:
        value = read_json(home, relative)
        if value is None:
            continue
        if not isinstance(value, dict) or not isinstance(value.get("extras"), list):
            return [], {"extras": f"{relative} has no extras array"}
        names = []
        for name in value["extras"][:MAX_EXTRAS]:
            if isinstance(name, str) and 0 < len(name) <= MAX_EXTRA_CHARS \
                    and re.fullmatch(r"[A-Za-z0-9_.\-]+", name):
                names.append(name)
        return sorted(set(names)), {}
    return [], {"extras": "not found"}


def read_lock(home: Path, files: list[str]) -> tuple[dict[str, str], dict[str, str]]:
    """Which upstream version is installed, so a stale table can say so."""
    for relative in files:
        value = read_json(home, relative)
        if value is None:
            continue
        entry = value.get("LazyVim") if isinstance(value, dict) else None
        commit = entry.get("commit") if isinstance(entry, dict) else None
        if isinstance(commit, str) and re.fullmatch(r"[0-9a-f]{7,40}", commit):
            return {"commit": commit[:MAX_COMMIT_CHARS]}, {}
        return {}, {"upstream": f"{relative} names no LazyVim commit"}
    return {}, {"upstream": "not found"}


def snapshot(profile: str, home: Path) -> dict[str, Any]:
    files = FILES[profile]
    options: dict[str, str] = {}
    skipped: dict[str, str] = {}
    extras: list[str] = []
    upstream: dict[str, str] = {}
    bindings: list[dict[str, Any]] = []
    binding_skipped: dict[str, int] = {}

    def attempt(reader, *args) -> tuple[Any, dict[str, str]]:
        try:
            return reader(*args)
        except Skipped as error:
            return None, {"file": sanitize_text(str(error), 128)}

    # LazyVim is the only profile left, and the only ground whose
    # configuration this knows the shape of.
    found, reasons = attempt(read_leader, home, files["leader"])
    options.update(found or {})
    skipped.update(reasons)
    found, reasons = attempt(read_extras, home, files["extras"])
    extras = found or []
    skipped.update(reasons)
    found, reasons = attempt(read_lock, home, files["lock"])
    upstream = found or {}
    skipped.update(reasons)
    found, reasons = attempt(read_keymaps, home, files["keymaps"])
    bindings = found or []
    binding_skipped = reasons

    return {
        "schemaVersion": SCHEMA_VERSION,
        "profile": profile,
        "options": options,
        "extras": extras,
        "upstream": upstream,
        "bindings": bindings,
        "bindingSkipped": binding_skipped,
        "deckConfig": read_decks(home, FILES["keycade"]["decks"]),
        # Every value this could not read, and why. A skipped value is visible
        # in the interface; a guessed one would not be.
        "skipped": skipped,
    }


def resolved_home(value: str | None) -> Path:
    """The home to read under, as one token, checked before it is used."""
    home = value if value is not None else os.environ.get("HOME", "")
    if not home or not home.startswith("/") or len(home) > 4096 \
            or has_controls(home):
        raise SystemExit(json.dumps({"schemaVersion": SCHEMA_VERSION, "type": "error",
                                     "error": "no usable home directory"}))
    return Path(home)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--profile", choices=["lazyvim"], required=True)
    parser.add_argument("--home", default=None,
                        help="read under this directory instead of $HOME (tests)")
    arguments = parser.parse_args()

    try:
        payload = snapshot(arguments.profile, resolved_home(arguments.home))
    except Exception as error:  # noqa: BLE001 - one line out, never a traceback
        payload = {"schemaVersion": SCHEMA_VERSION, "type": "error",
                   "error": sanitize_text(type(error).__name__, 128)}

    # ASCII escapes keep UTF-8 code points from being split by the consumer's
    # incremental raw-chunk parser. The byte budget applies after escaping.
    text = json.dumps(payload, ensure_ascii=True, separators=(",", ":"))
    if len(text.encode("utf-8")) > MAX_PAYLOAD_BYTES:
        text = json.dumps({"schemaVersion": SCHEMA_VERSION, "type": "error",
                           "error": "payload exceeds its limit"})
    sys.stdout.write(text + "\n")


if __name__ == "__main__":
    main()
