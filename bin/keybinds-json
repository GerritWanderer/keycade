#!/usr/bin/python3
"""Fail-closed launch preflight for the overlay's shortcut inhibition.

lib/InputGuard.qml refuses to raise the training overlay until this helper
confirms, through a read-only compositor query, that Hyprland does not have
``binds:disable_keybind_grabbing`` set. The one emitted record is
``{"schemaVersion": 1, "type": "guard", "disabled": bool}``; every failure -
an unreachable compositor, a malformed reply, an overlong stream - exits
non-zero instead, so a preflight that cannot answer blocks the launch.
"""

from __future__ import annotations

import argparse
import ctypes
import json
import os
import selectors
import signal
import stat
import subprocess
import sys
import time
import unicodedata
from typing import Any

SCHEMA_VERSION = 1
COMMAND_TIMEOUT_SECONDS = 3.0
MAX_COMMAND_STDOUT_BYTES = 4 * 1024 * 1024
MAX_COMMAND_STDERR_BYTES = 64 * 1024


class HelperError(RuntimeError):
    pass


HYPRCTL_PATH = "/usr/bin/hyprctl"
# Absolute so no library this keep-loaded path relies on is resolved by the
# dynamic loader's ambient search, and checked like every other trusted file
# before it is opened: an absolute path says nothing about who may replace it.
LIBC_PATH = "/usr/lib/libc.so.6"
# hyprctl only needs to locate the compositor socket. Everything else is
# dropped so a child never inherits an attacker-influenced environment.
CHILD_ENVIRONMENT_KEYS = ("HYPRLAND_INSTANCE_SIGNATURE", "XDG_RUNTIME_DIR")
# Everything this helper needs. Its own environment is scrubbed to the same
# whitelist the child is rebuilt from, so a variable a library starts reading
# later cannot slip through the way it would past a chased blacklist.
HELPER_ENVIRONMENT_KEYS = ("PATH", "HYPRLAND_INSTANCE_SIGNATURE", "XDG_RUNTIME_DIR")
PR_SET_PDEATHSIG = 1
# The helper's own PID, captured before any child is forked. A child reads its
# parent back only after the fork, and by then the answer may already be an
# adoptive parent - init or a subreaper - because the helper died in between.
# Comparing against the identity captured here closes that race; reading the
# parent for the first time inside the child cannot.
_HELPER_PID = os.getpid()


def trusted_command(path: str) -> str:
    """Return ``path`` only when it is a root-owned, non-writable executable.

    Commands are addressed by absolute path so nothing is resolved through the
    ambient ``PATH`` of the long-lived shell process that hosts the plugin. The
    dynamic libraries this helper loads go through the same check, since an
    absolute path alone still trusts whoever can write the file behind it.
    """
    try:
        info = os.stat(path)
    except OSError as error:
        raise HelperError(f"{path} is unavailable") from error
    if not stat.S_ISREG(info.st_mode):
        raise HelperError(f"{path} is not a regular file")
    if info.st_uid != 0:
        raise HelperError(f"{path} is not owned by root")
    if info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise HelperError(f"{path} is group or world writable")
    if not info.st_mode & stat.S_IXUSR:
        raise HelperError(f"{path} is not executable")
    return path


def child_environment() -> dict[str, str]:
    environment = {"PATH": "/usr/bin"}
    for name in CHILD_ENVIRONMENT_KEYS:
        value = os.environ.get(name)
        if value:
            environment[name] = value
    return environment


def _prepare_child() -> None:
    # Start a new session so the helper can signal the child's whole group.
    os.setsid()
    # Before anything is armed: a helper that already died means this child
    # was adopted, and the parent it reads back is not the helper's.
    if os.getppid() != _HELPER_PID:
        os._exit(1)
    # Ask the kernel to kill the child if the helper dies first. A child that
    # cannot arm the death signal must never exec: anything failing here
    # raises, which fails the spawn instead of leaving a running child behind
    # that nothing can reap.
    libc = ctypes.CDLL(trusted_command(LIBC_PATH), use_errno=True)
    if libc.prctl(PR_SET_PDEATHSIG, signal.SIGKILL) != 0:
        raise OSError(ctypes.get_errno(), "prctl(PR_SET_PDEATHSIG) failed")
    # The helper died between the fork and the arming above: the death signal
    # is then armed against the adoptive parent and never fires for the
    # helper. Leave before exec rather than run unguarded.
    if os.getppid() != _HELPER_PID:
        os._exit(1)


def _kill_process_group(process: subprocess.Popen[bytes]) -> None:
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    try:
        process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()


_ACTIVE_CHILD: subprocess.Popen[bytes] | None = None


def _terminate(_signum: int, _frame: Any) -> None:
    # A consumer that wants this helper gone sends SIGTERM first. Reap the
    # child process group here so the tree cannot outlive the helper; the
    # kernel death signal set in _prepare_child covers an immediate SIGKILL.
    if _ACTIVE_CHILD is not None:
        _kill_process_group(_ACTIVE_CHILD)
    os._exit(143)


def install_signal_handlers() -> None:
    signal.signal(signal.SIGTERM, _terminate)
    signal.signal(signal.SIGHUP, _terminate)


def command_output(
    command: list[str],
    *,
    max_stdout: int = MAX_COMMAND_STDOUT_BYTES,
    max_stderr: int = MAX_COMMAND_STDERR_BYTES,
    timeout: float = COMMAND_TIMEOUT_SECONDS,
) -> str:
    try:
        process = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=child_environment(),
            preexec_fn=_prepare_child,
            close_fds=True,
        )
    except (OSError, subprocess.SubprocessError) as error:
        # A preexec_fn failure (death-signal setup included) surfaces as a
        # spawn failure: no child ever runs without its reaping guarantees.
        raise HelperError(f"{' '.join(command)} failed: {error}") from error

    global _ACTIVE_CHILD
    _ACTIVE_CHILD = process
    streams = None
    try:
        streams = selectors.DefaultSelector()
        assert process.stdout is not None and process.stderr is not None
        streams.register(process.stdout, selectors.EVENT_READ, ("stdout", max_stdout))
        streams.register(process.stderr, selectors.EVENT_READ, ("stderr", max_stderr))
        buffers = {"stdout": bytearray(), "stderr": bytearray()}
        deadline = time.monotonic() + timeout
        while streams.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise HelperError(f"{' '.join(command)} exceeded its deadline")
            events = streams.select(min(remaining, 0.1))
            if not events and process.poll() is not None:
                events = [(key, 0) for key in list(streams.get_map().values())]
            for key, _mask in events:
                chunk = os.read(key.fd, 65536)
                if not chunk:
                    streams.unregister(key.fileobj)
                    continue
                name, limit = key.data
                buffers[name].extend(chunk)
                if len(buffers[name]) > limit:
                    raise HelperError(f"{' '.join(command)} exceeded its {name} byte limit")
        return_code = process.wait(timeout=max(0.01, deadline - time.monotonic()))
        if return_code != 0:
            detail = buffers["stderr"].decode("utf-8", errors="replace").strip()
            detail = sanitize_text(detail, 512) if detail else f"exit status {return_code}"
            raise HelperError(f"{' '.join(command)} failed: {detail}")
        return buffers["stdout"].decode("utf-8", errors="strict")
    except subprocess.TimeoutExpired as error:
        raise HelperError(f"{' '.join(command)} exceeded its deadline") from error
    except (OSError, UnicodeError) as error:
        raise HelperError(f"{' '.join(command)} failed: {error}") from error
    finally:
        # Every exit from the block above - success, over-limit, deadline,
        # selector, read or decode failure - terminates and reaps the whole
        # group and resets the teardown state; no path may leave the tree
        # running or the signal handler pointing at a finished child.
        _kill_process_group(process)
        _ACTIVE_CHILD = None
        if streams is not None:
            streams.close()
        process.stdout.close()
        process.stderr.close()


def sanitize_text(value: Any, limit: int) -> str:
    text = unicodedata.normalize("NFC", str(value or ""))
    cleaned = "".join(" " if unicodedata.category(char).startswith("C") else char for char in text)
    if len(cleaned) > limit:
        raise HelperError(f"field exceeds {limit} characters")
    return cleaned


def scrub_environment() -> None:
    for name in [name for name in os.environ if name not in HELPER_ENVIRONMENT_KEYS]:
        os.environ.pop(name, None)


# The option the launch preflight must prove is off. Replies are validated
# against the two shapes hyprctl getoption has actually emitted for a boolean
# option: an integer field through Hyprland 0.54, a JSON boolean from 0.55 on.
GUARD_OPTION = "binds:disable_keybind_grabbing"
# The value keys hyprctl getoption answers with, one per config value type.
# More than one of them - or a single one that is not a boolean spelling - is
# a reply about some other kind of option and says nothing about this one.
GUARD_VALUE_FIELDS = (
    "bool", "int", "str", "float", "vec2", "custom", "css", "gradient", "font_weight",
)


def guard_disabled(option: Any) -> bool:
    """The disable_keybind_grabbing verdict from a getoption reply.

    Fail closed: the reply must be exactly one of the two versioned shapes a
    boolean option produces. A wrong-typed field, several value fields, a
    value spelling meant for a differently typed option, or an answer about a
    different option altogether are all errors rather than a "not disabled"
    reading.
    """
    if not isinstance(option, dict):
        raise HelperError("Hyprland preflight returned a non-object")
    if option.get("option") != GUARD_OPTION:
        raise HelperError("Hyprland preflight answered for an unexpected option")
    values = [name for name in GUARD_VALUE_FIELDS if name in option]
    if not values:
        raise HelperError("Hyprland preflight omitted its value")
    if len(values) > 1:
        raise HelperError("Hyprland preflight carries conflicting value fields")
    if values[0] == "bool":
        # Hyprland 0.55 and later.
        value = option["bool"]
        if not isinstance(value, bool):
            raise HelperError("Hyprland preflight bool is not a boolean")
        return value
    if values[0] == "int":
        # Hyprland 0.54 and earlier: booleans were integers, 0 or 1.
        value = option["int"]
        if isinstance(value, bool) or not isinstance(value, int) or value not in (0, 1):
            raise HelperError("Hyprland preflight int is not a boolean value")
        return value == 1
    raise HelperError("Hyprland preflight value is not a boolean")


def guard_status() -> dict[str, Any]:
    """Whether Hyprland disables the keybind grabbing the overlay relies on.

    Read-only: ``getoption`` never changes compositor state. The reply is
    validated against the versioned shapes a boolean option takes, so a reply
    that cannot prove grabbing is intact fails closed instead of guessing.
    """
    raw_option = command_output(
        [trusted_command(HYPRCTL_PATH), "-j", "getoption", GUARD_OPTION],
        max_stdout=64 * 1024,
    )
    return {
        "schemaVersion": SCHEMA_VERSION,
        "type": "guard",
        "disabled": guard_disabled(json.loads(raw_option)),
    }


def main() -> int:
    scrub_environment()
    install_signal_handlers()
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--guard-status",
        action="store_true",
        required=True,
        help="emit the disable_keybind_grabbing preflight record and exit",
    )
    parser.parse_args()

    try:
        result = guard_status()
    except (OSError, UnicodeError, json.JSONDecodeError, HelperError) as error:
        print(json.dumps({"schemaVersion": SCHEMA_VERSION, "type": "error", "error": str(error)}))
        return 1
    encoded = json.dumps(result, ensure_ascii=False).encode("utf-8")
    sys.stdout.buffer.write(encoded + b"\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
